# Public base URL of the deployed site. Used for canonical URLs, sitemap, JSON-LD
# and link-preview images (WhatsApp, LinkedIn, iMessage).
# On Vercel, VERCEL_URL is used automatically when this is unset — set it anyway
# for a stable custom domain (e.g. https://verdian-three.vercel.app).
NEXT_PUBLIC_SITE_URL=https://verdian-three.vercel.app

# Where website leads (contact form, service enquiries, careers) are delivered.
LEAD_INBOX=
CAREERS_INBOX=

# Transactional email provider. Leave empty in development: submissions are
# validated and logged to the server console instead of being emailed.
RESEND_API_KEY=
LEAD_FROM_EMAIL=

# Form abuse limits, per client IP. Defaults are 5 submissions per 10 minutes.
# Raise them when running scripts/forms.mjs against a local server.
LEAD_RATE_LIMIT_MAX=
LEAD_RATE_LIMIT_WINDOW_MINUTES=

# Analytics (optional). Leave empty to keep the tags out of the page.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
