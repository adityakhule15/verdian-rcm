# Public base URL of the deployed site. Used for canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where website leads (contact form, service enquiries, careers) are delivered.
LEAD_INBOX=
CAREERS_INBOX=

# Transactional email provider. Leave empty in development: submissions are
# validated and logged to the server console instead of being emailed.
RESEND_API_KEY=
LEAD_FROM_EMAIL=

# Form abuse limits, per client IP. Defaults are 5 submissions per 10 minutes.
# Raise them when running scripts/forms.mjs against a local server.
LEAD_RATE_LIMIT_MAX=
LEAD_RATE_LIMIT_WINDOW_MINUTES=

# Analytics (optional). Leave empty to keep the tags out of the page.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
